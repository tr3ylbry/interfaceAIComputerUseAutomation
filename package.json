{
  "name": "interface-ai-computer-use-automation",
  "version": "0.1.0",
  "private": false,
  "description": "Take-home implementation for a discover-once, deterministic-replay computer-use automation system.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "proxy": "npm run build && node dist/src/demo/legacy-bank-server.js",
    "demo": "npm run build && node dist/src/vertical-slice/run-demo.js",
    "discover": "npm run build && node dist/src/vertical-slice/run-discovery.js",
    "typecheck": "tsc --noEmit",
    "evidence:validate": "npm run build && node dist/src/evidence/validate-cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
