{
  "schemaVersion": "1.1",
  "capability": {
    "id": "legacy-core.member.read-savings-balance",
    "version": "0.1.0",
    "name": "Read member savings balance",
    "description": "Look up a member and return the current savings balance.",
    "approvalState": "draft"
  },
  "target": {
    "application": "LegacyCore Demo",
    "productFamily": "legacy-core-demo",
    "surfaceKind": "web",
    "entryPoint": "http://127.0.0.1:3000/member-search",
    "bindingProfile": "legacy-core-demo.base"
  },
  "inputs": [
    {
      "name": "member_id",
      "type": "string",
      "description": "Fake demo member identifier supplied by the caller.",
      "required": true,
      "sensitive": true,
      "validation": {
        "minLength": 1,
        "maxLength": 32
      }
    }
  ],
  "outputs": [
    {
      "name": "savings_balance",
      "type": "currency",
      "description": "Current savings balance for the located fake demo member.",
      "required": true,
      "sensitive": true
    }
  ],
  "targets": [
    {
      "id": "permission-denied",
      "description": "Explicit access-denied application state",
      "strategies": [{ "kind": "text", "text": "Permission denied", "exact": true }]
    },
    {
      "id": "operator-warning",
      "description": "Unexpected dialog requiring operator review",
      "strategies": [{ "kind": "selector", "engine": "css", "selector": "dialog[open]" }]
    },
    {
      "id": "host-busy",
      "description": "Known temporary host-busy state",
      "strategies": [{ "kind": "text", "text": "Core host is temporarily busy", "exact": true }]
    },
    {
      "id": "retry-inquiry",
      "description": "Safe inquiry retry link on the known busy screen",
      "strategies": [{ "kind": "text", "text": "Retry inquiry", "exact": true }]
    },
    {
      "id": "member-id-input",
      "description": "Member identifier search input",
      "strategies": [
        {
          "kind": "accessibility",
          "role": "textbox",
          "name": "Member ID",
          "exact": true
        },
        {
          "kind": "label",
          "label": "Member ID",
          "exact": true
        },
        {
          "kind": "selector",
          "engine": "css",
          "selector": "input[name='memberNumber']"
        }
      ]
    },
    {
      "id": "member-search-button",
      "description": "Search action",
      "strategies": [
        {
          "kind": "accessibility",
          "role": "button",
          "name": "Search",
          "exact": true
        },
        {
          "kind": "text",
          "text": "Search",
          "exact": true
        }
      ]
    },
    {
      "id": "account-information-link",
      "description": "Account information navigation link",
      "strategies": [
        {
          "kind": "accessibility",
          "role": "link",
          "name": "Account Information",
          "exact": true
        },
        {
          "kind": "text",
          "text": "Account Information",
          "exact": true
        }
      ]
    },
    {
      "id": "savings-balance-value",
      "description": "Savings balance value in the account-information frame",
      "framePath": ["iframe[name='accountPane']"],
      "strategies": [
        {
          "kind": "relative",
          "anchorText": "Savings",
          "relation": "nearest",
          "controlHint": "value",
          "ordinal": 1
        },
        {
          "kind": "selector",
          "engine": "xpath",
          "selector": "//tr[td[normalize-space()='Savings']]//span[contains(@class, 'balance-value')]"
        }
      ]
    },
    {
      "id": "member-not-found-message",
      "description": "Member-not-found business message",
      "strategies": [
        {
          "kind": "text",
          "text": "Member not found",
          "exact": true
        }
      ]
    }
  ],
  "steps": [
    {
      "id": "fill-member-id",
      "description": "Enter the requested member identifier.",
      "risk": "read_only",
      "action": "fill",
      "targetId": "member-id-input",
      "value": {
        "source": "input",
        "name": "member_id"
      },
      "clearFirst": true
    },
    {
      "id": "search-member",
      "description": "Submit the member lookup.",
      "risk": "read_only",
      "action": "click",
      "targetId": "member-search-button",
      "recoveryPolicyId": "transient-search-load",
      "checkpoint": {
        "kind": "any",
        "conditions": [
          {
            "kind": "element_state",
            "targetId": "account-information-link",
            "state": "visible",
            "timeoutMs": 10000
          },
          {
            "kind": "element_state",
            "targetId": "member-not-found-message",
            "state": "visible",
            "timeoutMs": 10000
          }
        ]
      }
    },
    {
      "id": "open-account-information",
      "description": "Open account information for the located member.",
      "risk": "read_only",
      "action": "click",
      "targetId": "account-information-link",
      "checkpoint": {
        "kind": "url",
        "operator": "contains",
        "expected": "/accounts",
        "timeoutMs": 5000
      }
    },
    {
      "id": "extract-savings-balance",
      "description": "Extract the visible savings balance.",
      "risk": "read_only",
      "action": "extract",
      "targetId": "savings-balance-value",
      "outputName": "savings_balance",
      "extraction": "text",
      "transform": "currency_to_number"
    }
  ],
  "businessOutcomes": [
    {
      "code": "MEMBER_NOT_FOUND",
      "description": "The lookup completed successfully but the application reports no matching member.",
      "when": {
        "kind": "element_state",
        "targetId": "member-not-found-message",
        "state": "visible",
        "timeoutMs": 1000
      }
    }
  ],
  "recoveryPolicies": [
    {
      "id": "transient-search-load",
      "appliesTo": ["timeout", "transient_load"],
      "maxAttempts": 2,
      "backoffMs": 0,
      "dismissTargetId": "retry-inquiry"
    }
  ],
  "successCondition": {
    "kind": "output",
    "outputName": "savings_balance",
    "operator": "defined",
    "timeoutMs": 1000
  },
  "runtimeConditions": [
    {
      "id": "permission-denied-state",
      "when": { "kind": "element_state", "targetId": "permission-denied", "state": "visible", "timeoutMs": 100 },
      "disposition": { "kind": "failure", "code": "permission_denied" }
    },
    {
      "id": "operator-warning-state",
      "when": { "kind": "element_state", "targetId": "operator-warning", "state": "visible", "timeoutMs": 100 },
      "disposition": { "kind": "intervention", "reason": "unexpected_state" }
    },
    {
      "id": "host-busy-state",
      "when": { "kind": "element_state", "targetId": "host-busy", "state": "visible", "timeoutMs": 100 },
      "disposition": { "kind": "recoverable", "code": "transient_load" }
    }
  ],
  "policy": {
    "allowedOrigins": ["http://127.0.0.1:3000"],
    "allowedPathPatterns": ["/member-search", "/members/*"],
    "allowedActions": ["click", "fill", "wait", "extract"],
    "irreversibleActionPolicy": "require_human"
  },
  "provenance": {
    "discoveryRunId": "fixture-not-a-real-discovery-run",
    "createdAt": "2026-09-27T18:00:00.000Z",
    "compilerVersion": "0.1.0"
  }
}
